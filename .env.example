# ============================================================================
# Chatly Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit real credentials!

# ── Firebase (required) ──────────────────────────────────────────────────────
# Create a Firebase project at https://console.firebase.google.com
# Then run: flutterfire configure
# Or set these environment variables:
FIREBASE_API_KEY=YOUR_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Unsplash API (optional — for chat wallpapers) ────────────────────────────
# Get your key from: https://unsplash.com/developers
UNSPLASH_API_KEY=

# ── Perspective API (optional — toxicity detection) ──────────────────────────
# Get your key from: https://perspectiveapi.com
PERSPECTIVE_API_KEY=

# ── RevenueCat (optional — in-app subscriptions) ─────────────────────────────
# Get your key from: https://www.revenuecat.com
REVENUECAT_API_KEY=

# ── App Configuration ────────────────────────────────────────────────────────
ENABLE_ANALYTICS=true
DEBUG_MODE=false
